{
  "$schema": "https://unpkg.com/wrangler@4.149.0/config-schema.json",
  "name": "whattimeisthef1",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "whattimeisthef1.com", "custom_domain": true }
  ]
}
